{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PinWP Studio",
  "version": "0.1.0",
  "identifier": "com.pincodeit.pinwpstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "PinWP Studio",
      "width": 1440,
      "height": 900,
      "minWidth": 1024,
      "minHeight": 700,
      "center": true,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "DeveloperTool",
    "shortDescription": "Local WordPress development workstation"
  }
}
